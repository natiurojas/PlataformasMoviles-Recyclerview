<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MarioKartRecycler" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/mk_pink</item>
        <item name="colorPrimaryVariant">@color/mk_pink_dark</item>
        <item name="colorOnPrimary">@color/mk_white</item>
        <item name="colorSecondary">@color/mk_cyan</item>
        <item name="colorSecondaryVariant">@color/mk_cyan_dark</item>
        <item name="colorOnSecondary">@color/mk_dark</item>
        <item name="android:windowBackground">@color/mk_dark</item>
        <item name="android:statusBarColor">@color/mk_pink</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/mk_dark</item>
    </style>

    <!-- Forma circular para la imagen del personaje -->
    <style name="ShapeAppearanceOverlay.MK.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Sombra para títulos arcade -->
    <style name="TextoArcade">
        <item name="android:shadowColor">#99000000</item>
        <item name="android:shadowDx">3</item>
        <item name="android:shadowDy">3</item>
        <item name="android:shadowRadius">2</item>
    </style>
</resources>
