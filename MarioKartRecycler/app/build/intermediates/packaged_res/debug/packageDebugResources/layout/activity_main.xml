<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mk_dark"
    android:orientation="vertical">

    <!-- Cabecera estilo Mario Kart -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/mk_pink"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_personajes"
            android:textColor="@color/mk_yellow"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:shadowColor="#99000000"
            android:shadowDx="3"
            android:shadowDy="3"
            android:shadowRadius="2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/subtitle_personajes"
            android:textColor="@color/mk_white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.2" />
    </LinearLayout>

    <!-- Banda de cuadros (banderín de meta) -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:scaleType="fitXY"
        android:src="@drawable/bg_checker_flag" />

    <!-- Franja cian fina -->
    <View
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="@color/mk_cyan" />

    <!-- Lista de personajes -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="10dp"
        android:paddingTop="12dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp"
        android:scrollbars="vertical" />

</LinearLayout>
